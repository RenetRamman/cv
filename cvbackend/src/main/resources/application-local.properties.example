# Copy this file to application-local.properties for local development.
# application-local.properties is gitignored and loaded when the "local" profile is active.
#
# Keep these values in sync with the DB_* / POSTGRES_* entries in the project-root .env file.

spring.datasource.url=jdbc:postgresql://localhost:5432/cv
spring.datasource.username=cv
spring.datasource.password=cv

# Apply schema migrations + local seed data (not used by the test profile).
spring.flyway.locations=classpath:db/migration,classpath:db/seed
