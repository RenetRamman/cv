# Copy this file to .env for local development.
# .env is gitignored and used by docker compose (and can be exported for the backend).

POSTGRES_DB=cv
POSTGRES_USER=cv
POSTGRES_PASSWORD=cv

# Spring Boot datasource (used when exported, or mirrored in application-local.properties)
DB_URL=jdbc:postgresql://localhost:5432/cv
DB_USERNAME=cv
DB_PASSWORD=cv
